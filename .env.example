# ---------------------------------------------------------------------------
# Production deployment contract for pikkuste-harjutaja.
# Copy to `.env` (which docker compose reads automatically) and fill in real
# values. The verified startup workflow (npm start) refuses to boot in
# production unless the required variables below are present and valid.
# ---------------------------------------------------------------------------

# REQUIRED. scrypt hash of the family access PIN. Generate it (never commit the
# plaintext PIN) with:
#   npm run auth:hash -- 1234
# Startup fails unless this is a scrypt hash produced by that command.
#
# IMPORTANT: the hash contains '$' characters (scrypt$v=1$N=...). docker compose
# performs variable interpolation on unquoted and double-quoted values, so an
# unquoted hash would have "$v", "$N" etc. expanded and the container would then
# reject it. ALWAYS wrap the value in SINGLE quotes, which Compose treats as a
# literal. Example (not a real hash):
#   APP_ACCESS_PIN_HASH='scrypt$v=1$N=16384,r=8,p=1$c2FsdA$aGFzaA'
APP_ACCESS_PIN_HASH=''

# REQUIRED. Secret used to sign family/parent session cookies. Must be at least
# 32 characters. Generate one with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SESSION_SECRET_CURRENT=

# OPTIONAL. Previous signing secret, kept during a rotation so existing sessions
# stay valid. Also at least 32 characters. Leave empty when not rotating.
APP_SESSION_SECRET_PREVIOUS=

# REQUIRED. The exact public origin the app is served from. MUST be HTTPS in
# production and MUST NOT include a path or trailing slash.
#   Good: https://harjutaja.example.com
#   Bad:  http://harjutaja.example.com   (not HTTPS)
#   Bad:  https://harjutaja.example.com/ (trailing slash / path)
APP_ORIGIN=https://harjutaja.example.com

# Protocol v2 is the only accepted write protocol. Keep this explicit in
# production; `0` and malformed values are rejected and protocol v1 uploads
# receive `426 Upgrade Required` without altering their local records.
OFFLINE_PROTOCOL_V2_ENABLED=1

# OPTIONAL. SQLite database file inside the container. Defaults to
# /data/maths-game.sqlite, which is the mounted volume in docker-compose.yml.
# MATHS_GAME_DB_FILE=/data/maths-game.sqlite

# OPTIONAL. Directory for the pre-startup database backup. Defaults to a
# `backups/` folder next to the database file.
# MATHS_GAME_BACKUP_DIR=/data/backups
